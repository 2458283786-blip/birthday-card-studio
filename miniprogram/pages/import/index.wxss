.page {
  min-height: 100vh;
  background: var(--paper);
}

.body {
  padding: 40rpx 56rpx 80rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--ink);
}

.sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--ink-muted);
}

.field {
  margin-top: 64rpx;
  border-bottom: 2rpx solid var(--ink);
  transition: border-color 200ms ease;
}

.field-warn {
  border-bottom-color: #c0563f;
}

.input {
  width: 100%;
  height: 108rpx;
  font-size: 46rpx;
  letter-spacing: 0.22em;
  color: var(--ink);
}

.ph {
  color: #cfd3da;
  letter-spacing: 0.22em;
}

.tip {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #c0563f;
}

.btn {
  margin-top: 56rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: var(--ink);
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.1em;
}

.btn.busy {
  opacity: 0.55;
}

.note {
  margin-top: 32rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--ink-faint);
}

.demo {
  margin-top: 96rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--hair);
}

.demo-h {
  font-size: 22rpx;
  color: var(--ink-faint);
}

.demo-row {
  margin-top: 20rpx;
  display: flex;
}

.demo-code {
  padding: 14rpx 26rpx;
  margin-right: 20rpx;
  border: 1rpx solid var(--hair);
  border-radius: 12rpx;
  font-size: 26rpx;
  color: var(--ink);
  background: #fafafa;
}

.demo-note {
  margin-top: 24rpx;
  font-size: 21rpx;
  line-height: 1.7;
  color: var(--ink-faint);
}
