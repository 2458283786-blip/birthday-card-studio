.page {
  min-height: 100vh;
  background: var(--paper);
}

.head {
  height: 96rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 48rpx 16rpx;
}

.brand {
  font-size: 26rpx;
  color: var(--ink);
}

.count {
  font-size: 20rpx;
  color: var(--ink-faint);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 40rpx 48rpx 80rpx;
}

.cell {
  width: 300rpx;
  margin-bottom: 56rpx;
}

.thumb {
  width: 300rpx;
  height: 450rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #eceef1;
  box-shadow: 0 12rpx 28rpx rgba(22, 24, 29, 0.14);
}

.thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.id {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: var(--ink);
}

.date {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--ink-faint);
}

/* 空态 */
.empty {
  padding: 240rpx 48rpx 0;
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  color: var(--ink-faint);
}

.empty-sub {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--ink-faint);
}
