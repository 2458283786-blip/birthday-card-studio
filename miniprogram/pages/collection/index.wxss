.page {
  min-height: 100vh;
  background: var(--paper);
}

.head {
  height: 96rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 0 48rpx 16rpx;
}

.brand {
  font-size: 26rpx;
  color: var(--ink);
}

.head-right {
  display: flex;
  align-items: center;
}

.count {
  font-size: 20rpx;
  color: var(--ink-faint);
}

.import-btn {
  margin-left: 28rpx;
  padding: 6rpx 20rpx;
  font-size: 21rpx;
  color: var(--ink);
  border: 1rpx solid var(--hair);
  border-radius: 10rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 40rpx 48rpx 80rpx;
}

/* 离线提示: 一行小字, 不抢眼但必须说清楚 */
.offline {
  padding: 24rpx 48rpx 0;
  font-size: 21rpx;
  color: var(--ink-faint);
}

.cell {
  width: 300rpx;
  margin-bottom: 56rpx;
}

.thumb {
  width: 300rpx;
  height: 450rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #eceef1;
  box-shadow: 0 12rpx 28rpx rgba(22, 24, 29, 0.14);
}

.thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.id {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: var(--ink);
}

.date {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--ink-faint);
}

/* 空态: 不留空卡框, 直接告诉他怎么把卡拿进来 */
.empty {
  padding: 200rpx 48rpx 0;
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  color: var(--ink-faint);
}

.empty-sub {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--ink-faint);
}

.empty-btn {
  margin: 56rpx auto 0;
  width: 360rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--ink);
  color: #ffffff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.08em;
}

/* 本地演示模式才有 */
.demo {
  margin-top: 140rpx;
}

.demo-h {
  font-size: 21rpx;
  color: var(--ink-faint);
}

.demo-code {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--ink-muted);
}
