<!-- 收藏馆: 白底 · 一行两个 · 只显示已经导入的卡 -->
<view class="page" style="padding-top:{{statusBar}}px">

  <view class="head">
    <text class="latin brand">Collection</text>
    <view class="head-right">
      <text class="latin count" wx:if="{{countText}}">{{countText}}</text>
      <view class="latin import-btn" bindtap="onImport">导入</view>
    </view>
  </view>
  <view class="hair"></view>

  <!-- 用的是本地的上次列表: 说明一句, 别让人以为卡丢了 -->
  <view class="offline" wx:if="{{offline && cards.length}}">
    离线查看 · 连上网络后会自动更新
  </view>

  <view class="grid" wx:if="{{cards.length}}">
    <view
      class="cell"
      wx:for="{{cards}}"
      wx:key="cardId"
      id="t-{{item.cardId}}"
      data-id="{{item.cardId}}"
      bindtap="onOpen"
    >
      <view class="thumb">
        <image class="thumb-img" src="{{item.flat}}" mode="aspectFill" lazy-load />
      </view>
      <view class="latin id">{{item.displayId}}</view>
      <view class="latin date">{{item.dateText}}</view>
    </view>
  </view>

  <!-- 连不上云端、本地也没缓存: 说清楚并给重试, 不要显示"还没有卡" -->
  <view class="empty" wx:elif="{{failed}}">
    <view class="empty-title">暂时连不上</view>
    <view class="empty-sub">网络或云端环境有问题，稍后再试一次</view>
    <view class="empty-btn" bindtap="onRetry">重试</view>
  </view>

  <!-- 真的没有卡: 不留空卡框, 直接告诉他怎么把卡拿进来 -->
  <view class="empty" wx:elif="{{!loading}}">
    <view class="empty-title">还没有卡</view>
    <view class="empty-sub">输入我们发给你的导入码，卡就会出现在这里</view>
    <view class="empty-btn" bindtap="onImport">输入导入码</view>

    <view class="demo" wx:if="{{demo.length}}">
      <view class="demo-h">本地演示码（长按可重置）</view>
      <view class="demo-code latin" wx:for="{{demo}}" wx:key="*this" bindlongpress="onResetMock">{{item}}</view>
    </view>
  </view>

</view>
