<!-- 卡牌页: 白底 · 卡片居中 · 拖动/陀螺仪/翻面 · 卡下方只留卡号与日期 -->
<view class="page" style="background:{{bg}}">
  <view style="height:{{statusBar}}px"></view>

  <view class="bar-in">
    <view class="ico back" bindtap="goBack"></view>
    <view class="bar-right">
      <view class="ico save" bindtap="onSave"></view>
      <button class="share-btn" open-type="share">
        <view class="ico share"></view>
      </button>
    </view>
  </view>

  <block wx:if="{{card}}">
    <view class="stage-wrap" style="padding: {{padT}}px {{padX}}px 0">
      <view class="enter {{ready ? 'in' : ''}}" style="{{enterStyle}}">
        <holo-card card="{{card}}" />
      </view>
    </view>

    <!-- 卡下方只留身份信息: 卡号 + 纪念日期。
         寄语/署名/拥有者这些字段没有删, 它们仍然在卡面与卡背上;
         这里不重复显示, 页面才是干净的。 -->
    <view class="meta {{ready ? 'in' : ''}}">
      <view class="latin m-id">{{card.displayId}}<text class="sep">·</text>{{card.dateText}}</view>
    </view>

    <view class="hint {{hintOff ? 'off' : ''}}">拖动旋转 · 点击翻面</view>
  </block>

  <!-- 找不到这张卡 / 数据层出错: 说清楚是哪一种, 不装成"内容为空" -->
  <view class="missing" wx:else>
    <view class="missing-t">{{failed ? '卡牌数据读取出错' : '这张卡不在这里'}}</view>
    <view class="missing-s" wx:if="{{failed}}">看一下控制台的报错信息</view>
    <view class="missing-s" wx:elif="{{missing}}">它可能还没做好，或者链接不对</view>
  </view>

  <!-- 保存用画布(不在屏幕上显示) -->
  <canvas type="2d" id="export" class="export-canvas"></canvas>
</view>
