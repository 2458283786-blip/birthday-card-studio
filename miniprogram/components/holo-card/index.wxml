<wxs module="holo" src="./holo.wxs" />

<!--
  包装层各管一件事, 互不打架:
    .drift   太空漂浮(慢速位移+微转, 17s)
    .breathe 3D 呼吸(慢速 rotateX/rotateY, 13s) —— 静止时也一直是立体的
    .motion  陀螺仪跟随(逻辑层)
    .flipper 翻面(逻辑层, 转到 90° 侧对屏幕时才换图)
    .card3d  手指拖动 + 层间视差(WXS 直接改样式, 最跟手)
    .clip    裁剪成卡牌形状(圆角), 层在里面按深度错开
-->
<view
  class="stage"
  data-w="{{W}}"
  data-h="{{H}}"
  data-dbg="{{depths.background}}"
  data-dsu="{{depths.subject}}"
  data-dfx="{{depths.effects}}"
  data-foil="{{foil}}"
  data-holo="{{holoOn}}"
  bindtouchstart="{{holo.touchStart}}"
  bindtouchmove="{{holo.touchMove}}"
  bindtouchend="{{holo.touchEnd}}"
  bindtouchcancel="{{holo.touchEnd}}"
>
  <view class="drift {{floatOn ? 'on' : ''}}">
    <view class="breathe">
      <view class="motion" style="{{motionStyle}}">
        <view class="flipper" style="{{flipStyle}}">
          <view class="card3d">
            <view class="clip">

              <block wx:if="{{face === 'front' && !useFlat}}">
                <!-- l-txt 故意不参与视差(和 shader 一致: 文字固定贴在卡面), 所以它没有 WXS 选择钩子
                     check-mp-wxml: allow l-txt -->
                <image class="layer l-bg" src="{{L.background}}" style="{{LS.background}}" mode="aspectFill" />
                <image class="layer l-sub" src="{{L.subject}}" style="{{LS.subject}}" mode="aspectFill" />
                <image class="layer l-fx" src="{{L.effects}}" style="{{LS.effects}}" mode="aspectFill" />

                <!-- 材质层: 与网页版 CSS-3D 路径同一套做法(WebGL 不可用时网页也是这两层)。
                     位置很关键 —— 必须夹在"光点"和"文字"之间:
                     shader 里文字层的材质量默认是 0(app.js 的 matAmtOf: text → 0,
                     applyMat 直接提前返回), 也就是**字体是干净的、不上材质**。
                     把它放在文字下面, 就等于把材质只加在边框/主体/背景上。 -->
                <block wx:if="{{holoOn}}">
                  <view class="foil finish-{{finish}}" style="{{foilStyle}}"></view>
                  <view class="sheen" style="{{sheenStyle}}"></view>
                </block>

                <image class="layer l-txt" src="{{L.text}}" style="{{LS.text}}" mode="aspectFill" />
              </block>
              <image wx:elif="{{face === 'front'}}" class="layer" src="{{flat}}" mode="aspectFill" />
              <image wx:else class="layer" src="{{back}}" mode="aspectFill" binderror="onImgError" />

              <!-- 只有整图(没有分层)时: 文字已经烧在图里, 没法分开, 只能盖在上面 ——
                   网页版的降级路径也是这么做的。 -->
              <block wx:if="{{face === 'front' && holoOn && useFlat}}">
                <view class="foil finish-{{finish}}" style="{{foilStyle}}"></view>
                <view class="sheen" style="{{sheenStyle}}"></view>
              </block>

            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
