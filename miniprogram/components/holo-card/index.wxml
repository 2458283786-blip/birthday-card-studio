<wxs module="holo" src="./holo.wxs" />

<view
  class="stage"
  bindtouchstart="{{holo.touchStart}}"
  bindtouchmove="{{holo.touchMove}}"
  bindtouchend="{{holo.touchEnd}}"
  bindtouchcancel="{{holo.touchEnd}}"
>
  <!--
    float:  静置轻微浮动(CSS 动画)
    motion: 陀螺仪跟随(逻辑层, 约 16fps + CSS 过渡补顺滑)
    flip:   翻面(逻辑层, 转到 90° 侧对屏幕时才换图, 全程只有一张图 → 最稳)
    card3d: 手指拖动(WXS 直接改样式, 不走 setData)
  -->
  <view class="floater {{floatOn ? 'on' : ''}}">
    <view class="motion" style="{{motionStyle}}">
      <view class="flipper" style="{{flipStyle}}">
        <view class="card3d">
          <image class="card-img" src="{{src}}" mode="aspectFill" binderror="onImgError" />
        </view>
      </view>
    </view>
  </view>
</view>
