/* 卡牌: 整张成品图 + 浮动/陀螺仪/翻面/拖动
 * 四层包装各管一件事, 互不打架:
 *   .floater 静置浮动(动画) · .motion 陀螺仪(setData) · .flipper 翻面(JS) · .card3d 拖动(WXS)
 * 第一版不拆分层: 拆层会被透视缩放, 画面就和工坊生成的成品卡不一致。
 */
.stage {
  position: relative;
  width: 100%;
  padding-bottom: 150%;
  perspective: 1400rpx;
  -webkit-perspective: 1400rpx;
}

.floater,
.motion,
.flipper,
.card3d {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
}

.floater.on {
  animation: floaty 7s ease-in-out infinite;
}

@keyframes floaty {
  0%   { transform: translate3d(0, 0, 0) rotate(-0.3deg); }
  50%  { transform: translate3d(0, -10rpx, 0) rotate(0.3deg); }
  100% { transform: translate3d(0, 0, 0) rotate(-0.3deg); }
}

/* 翻面的过渡写在 JS 的 flipStyle 里(要分两段), 这里不设 transition */
.motion {
  transition: transform 220ms ease-out;
}

.card-img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 22rpx;
  box-shadow: 0 18rpx 40rpx rgba(22, 24, 29, 0.2);
}
