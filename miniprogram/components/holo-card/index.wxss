/* 卡牌: 一叠有前后距离的层 + 拖动/陀螺仪/翻面
 * 包装层各管一件事, 互不打架:
 *   .floater 静置浮动(动画) · .motion 陀螺仪(setData) · .flipper 翻面(class) · .card3d 拖动(WXS)
 */
.stage {
  position: relative;
  width: 100%;
  padding-bottom: 150%;
  perspective: 1400rpx;
  -webkit-perspective: 1400rpx;
}

.floater,
.motion,
.flipper,
.card3d,
.face {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.floater.on {
  animation: floaty 7s ease-in-out infinite;
}

@keyframes floaty {
  0%   { transform: translate3d(0, 0, 0) rotate(-0.3deg); }
  50%  { transform: translate3d(0, -10rpx, 0) rotate(0.3deg); }
  100% { transform: translate3d(0, 0, 0) rotate(-0.3deg); }
}

.motion {
  transition: transform 220ms ease-out;
}

.flipper {
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
  transition: transform 560ms cubic-bezier(0.22, 0.61, 0.36, 1);
}

.flipper.flipped {
  transform: rotateY(180deg);
}

.card3d {
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
}

.card3d.easing {
  transition: transform 520ms cubic-bezier(0.22, 0.61, 0.36, 1);
}

.face {
  transform-style: preserve-3d;
  -webkit-transform-style: preserve-3d;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
}

.face-back {
  transform: rotateY(180deg);
}

/* 每一层自己圆角 —— 不用 overflow:hidden, 否则会压平 3D */
.layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 22rpx;
  box-shadow: 0 18rpx 40rpx rgba(22, 24, 29, 0.18);
}
